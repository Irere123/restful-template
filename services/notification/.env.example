# Notification service

# Server
PORT=8084
NODE_ENV=development
LOG_LEVEL=info

# Database (own database — database-per-service)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restful_notification

# CORS
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Shared key for trusted service-to-service calls (must match across services)
INTERNAL_API_KEY=dev-internal-key

# Email (Resend) — REQUIRED in production. Get a key at https://resend.com/api-keys
# In development, leave RESEND_API_KEY blank to log emails (and OTP codes) instead of sending.
RESEND_API_KEY=
# Verified sender. The shared sandbox sender below only delivers to your own Resend account;
# use a domain you've verified in Resend for real recipients.
EMAIL_FROM="TZW Fire Safety <onboarding@resend.dev>"
APP_NAME=TZW Fire Safety
