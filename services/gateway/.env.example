# API Gateway — single public entry point

# Server
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# CORS — the gateway owns CORS for the whole system. Use an explicit origin in
# production (required when sending credentials).
CORS_ORIGIN=*

# Rate limiting (coarse, gateway-wide; services apply their own finer limits)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200

# Shared key (kept consistent across services; gateway does not use it directly)
INTERNAL_API_KEY=dev-internal-key

# Downstream services to reverse-proxy to
AUTH_URL=http://localhost:8081
MANAGEMENT_URL=http://localhost:8082
REPORTING_URL=http://localhost:8083
