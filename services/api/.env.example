# Server
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://user:password@localhost:5432/app

# CORS — use an explicit origin in production (required when sending credentials)
CORS_ORIGIN=*

# Cookie domain — REQUIRED in production. Auth cookies are scoped to `.DOMAIN`.
# DOMAIN=example.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Authentication — generate strong, DISTINCT secrets (>= 32 chars in production).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Email (Resend) — REQUIRED in production. Get a key at https://resend.com/api-keys
# In development, leave RESEND_API_KEY blank to log OTP codes instead of sending email.
RESEND_API_KEY=
# Verified sender. The shared sandbox sender below only delivers to your own account;
# use a domain you've verified in Resend for real recipients.
EMAIL_FROM="Acme <onboarding@resend.dev>"
APP_NAME=Acme
