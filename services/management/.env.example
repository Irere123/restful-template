# Fire Extinguisher Management service

# Server
PORT=8082
NODE_ENV=development
LOG_LEVEL=info

# Database (own database — database-per-service)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restful_management

# CORS
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Must match the auth service — used to statelessly verify access tokens (JWT)
ACCESS_TOKEN_SECRET=dev-access-secret-change-me-please-0001

# Shared key for trusted service-to-service calls (must match across services)
INTERNAL_API_KEY=dev-internal-key

# Downstream services
NOTIFICATION_URL=http://localhost:8084
# Auth service — used by the cron jobs to resolve alert recipients (by role)
AUTH_URL=http://localhost:8081

# Branding (used in emails)
APP_NAME=TZW Fire Safety

# ── Scheduled jobs (node-cron) ───────────────────────────────────────────────
# Master switch for the background scheduler.
CRON_ENABLED=true
# Flag an extinguisher "expiring soon" this many days before its expiry date.
EXPIRY_ALERT_WINDOW_DAYS=30
# Remind about scheduled inspections due within this many days.
INSPECTION_REMINDER_WINDOW_DAYS=3
# Roles that receive compliance alert digests (comma-separated).
ALERT_RECIPIENT_ROLES=admin,inspector
# Standard 5-field cron expressions (defaults: 08:00 and 07:00 daily).
EXPIRY_CRON=0 8 * * *
INSPECTION_REMINDER_CRON=0 7 * * *
