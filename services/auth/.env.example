# Auth & User Management service

# Server
PORT=8081
NODE_ENV=development
LOG_LEVEL=info

# Database (own database — database-per-service)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restful_auth

# CORS — use an explicit origin in production (required when sending credentials)
CORS_ORIGIN=*

# Cookie domain — REQUIRED in production. Auth cookies are scoped to `.DOMAIN`.
# DOMAIN=example.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Authentication — generate strong, DISTINCT secrets (>= 32 chars in production).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=dev-access-secret-change-me-please-0001
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me-please-0002

# Shared key for trusted service-to-service calls (must match across services)
INTERNAL_API_KEY=dev-internal-key

# Downstream services
NOTIFICATION_URL=http://localhost:8084

# Branding (used in emails)
APP_NAME=TZW Fire Safety
