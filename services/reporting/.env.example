# Reporting service (aggregator — no own database)

# Server
PORT=8083
NODE_ENV=development
LOG_LEVEL=info

# CORS
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Must match the auth service — used to statelessly verify access tokens (JWT)
ACCESS_TOKEN_SECRET=dev-access-secret-change-me-please-0001

# Shared key for trusted service-to-service calls (must match across services)
INTERNAL_API_KEY=dev-internal-key

# Upstream services this aggregator reads from
MANAGEMENT_URL=http://localhost:8082
AUTH_URL=http://localhost:8081
